# Supabase – get these from Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Required for creating profiles on signup (email confirmation callback).
# Use the "service_role" key (secret). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe – get from Stripe Dashboard → Developers → API keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# Stripe webhook – get from Stripe Dashboard → Developers → Webhooks
# For local testing: use `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=whsec_...

# PostHog – get from PostHog project settings
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Resend – transactional email (https://resend.com)
RESEND_API_KEY=re_QU72CELZ_Pu2mVjH5Q1UdmHcaGRe2UyCA
RESEND_FROM_EMAIL=Swifto <swifto9121@gmail.com>


# Vercel – set automatically by Vercel on deploy (do not add manually)
# VERCEL_URL=your-project.vercel.app

# Optional: Swifto GST number for receipts (if Swifto is GST-registered)
# NEXT_PUBLIC_SWIFTO_GST_NUMBER=00-000-000

# Admin emails for finance export (comma-separated, e.g. admin@swifto.com,you@example.com)
# ADMIN_EMAILS=admin@example.com

# Resend – transactional email (https://resend.com)
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=Swifto <notifications@yourdomain.com>
# Optional: base URL for email links (defaults to Vercel URL in prod)
# NEXT_PUBLIC_APP_URL=https://swifto.co.nz

# Supabase Database Webhook (for payout-to-student email): set in Supabase Dashboard when creating webhook
# SUPABASE_WEBHOOK_SECRET=your-secret

# Vercel Cron: set in Vercel env so cron requests use Authorization: Bearer <CRON_SECRET>
# CRON_SECRET=your-cron-secret
